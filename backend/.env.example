# Copia este archivo como .env y completa tus valores. Nunca subas el .env a GitHub.

PORT=4000
NODE_ENV=development
TZ=America/Bogota
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kuadri
# En la nube (por ejemplo Aiven): DB_SSL=true y, si lo tienes, el certificado CA en DB_CA_CERT
DB_SSL=false
DB_CA_CERT=

# Seguridad (usa una frase larga y aleatoria)
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_EXPIRES_IN=7d

# Correo para recordatorios (opcional). Si todo se deja vacío, los correos se muestran en la consola.
# Opción 1 (recomendada en la nube): API de Resend
RESEND_API_KEY=
RESEND_FROM=Kuadri <onboarding@resend.dev>

# Opción 2: servidor SMTP propio
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Kuadri <no-reply@kuadri.app>

# Recordatorios: cada cuánto se revisan y con cuántas horas de anticipación
REMINDER_CRON=*/15 * * * *
REMINDER_HOURS_BEFORE=24
